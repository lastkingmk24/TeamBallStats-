# TeamBallStats team sync server — copy to .env (ignored by git) or set these
# in your hosting provider's environment. Nothing here is a secret except
# BILLING_WEBHOOK_SECRET. The server reads only from the process environment;
# it does not load .env by itself, so use `set -a; . ./.env; set +a` or your
# platform's env settings.

# --- Network -----------------------------------------------------------------
# Address and port the HTTP server listens on.
HOST=0.0.0.0
PORT=8080

# --- Data --------------------------------------------------------------------
# Directory for the SQLite database (teamballstats.db). Relative paths are
# resolved from the repository root. Keep it OUTSIDE the web root and back it up.
DATA_DIR=data

# Accounts: set to 0 to close self-service sign-up (existing accounts still work).
ALLOW_REGISTRATION=1

# Largest request body accepted, in bytes (default 8 MiB).
MAX_BODY_BYTES=8388608

# --- Sessions and cookies ----------------------------------------------------
# Set to 1 when the site is served over HTTPS, so the session cookie is Secure.
# Leave it 0 only for local http:// development.
COOKIE_SECURE=0

# --- Billing -----------------------------------------------------------------
# No payment provider is bundled. Checkout returns 501 until one is wired in.
# The webhook endpoint refuses every request while this is empty.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BILLING_WEBHOOK_SECRET=

# --- Not configurable by environment (documented for reference) --------------
# Session lifetime: 30 days. Login throttle: 10 failures per 15 minutes per
# IP and username. Revision history: last 50 accepted writes per league.
